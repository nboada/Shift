{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shift",
  "version": "0.3.4",
  "identifier": "au.com.talkk.shift",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Shift",
        "width": 1240,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Nicolas Boada Morales (65AK786Q34)",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5REY1RTdBQzMzNzJGMzQKUldRMEx6ZkRlbDdmYWF4THEzUDJaOGtjcDlCb2JjbmJpSjl1ZlFIK0tGbzJrUkpKMWIxejdUOFAK",
      "endpoints": [
        "https://getshiftmail.com/updates/latest.json"
      ]
    }
  }
}
