// Site for getshiftmail.com (and the old shift.talkk.com.au, kept for installed apps): an Astro site built to dist/, plus a Worker that
// points the download and update feed at GitHub releases.
// Deploy: cd site && bunx wrangler deploy (runs the Astro build first; the roadmap build needs GitHub access via gh or GITHUB_TOKEN)
{
  "name": "shift-site",
  "account_id": "d2b1aef41d96a70b1eea2166fe0e0bdc",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "build": { "command": "bun run build" },
  // The Worker sees every request first, so it can move pages off the old domain (see src/worker.js).
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "getshiftmail.com", "custom_domain": true },
    { "pattern": "www.getshiftmail.com", "custom_domain": true },
    { "pattern": "shift.talkk.com.au", "custom_domain": true }
  ]
}
