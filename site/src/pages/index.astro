---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import splitLight from "../assets/app/split-light.webp";
import splitDark from "../assets/app/split-dark.webp";
import wideLight from "../assets/app/wide-light.webp";
import wideDark from "../assets/app/wide-dark.webp";
import accountsLight from "../assets/app/accounts-light.webp";
import accountsDark from "../assets/app/accounts-dark.webp";
import paletteLight from "../assets/app/palette-light.webp";
import paletteDark from "../assets/app/palette-dark.webp";
import composerLight from "../assets/app/composer-light.webp";
import composerDark from "../assets/app/composer-dark.webp";
// The AI icon the app uses (Tabler message-ai).
import aiIcon from "@tabler/icons/outline/message-ai.svg?raw";
---
<Base title="Shift: a fast email app for Mac" description="Shift is a fast, keyboard-friendly email app for macOS. Gmail, iCloud, Fastmail or your own domain in one inbox, and your mail stays on your Mac." path="/" appToggle>
  <main id="main">
    <section class="hero wrap">
      <h1>Email at the speed of your Mac.</h1>
      <p>Shift keeps a copy of your mail on your Mac, so every account opens, searches and switches instantly. Free and open source.</p>
      <div id="get" class="downloads">
        <a class="pill" href="/download"><span class="apple-logo" aria-hidden="true"></span>Download for macOS</a>
        <a class="pill ghost" href="https://github.com/nboada/Shift"><i class="ph ph-github-logo" aria-hidden="true"></i>View on GitHub</a>
      </div>
      <dl class="stats" aria-label="Shift in numbers">
        <div><dt>download</dt><dd>15 MB</dd></div>
        <div><dt>memory in use</dt><dd>~120 MB</dd></div>
        <div><dt>native core</dt><dd>Rust</dd></div>
        <div><dt>Shift servers</dt><dd>0</dd></div>
      </dl>
    </section>

    <div class="wrap">
      <!-- Screenshots from the demo mailbox (SHIFT_DEMO=1), so no real inbox is shown. -->
      <div class="stage hero-stage" data-layout="split">
        <div class="segmented labelled layout-switch" role="group" aria-label="Layout">
          <button type="button" data-layout="split" aria-pressed="true"><i class="ph ph-columns" aria-hidden="true"></i>Split view</button>
          <button type="button" data-layout="wide" aria-pressed="false"><i class="ph ph-rows" aria-hidden="true"></i>Wide view</button>
        </div>
        <div class="hero-shots">
          <div class="layout-shot" data-shot="split">
            <Shot light={splitLight} dark={splitDark} alt="Shift in split view: mailboxes, the Smart Inbox and an open email side by side" eager />
          </div>
          <div class="layout-shot" data-shot="wide">
            <Shot light={wideLight} dark={wideDark} alt="Shift in wide view: the Smart Inbox across the whole window, one email per line" />
          </div>
        </div>
        <p class="layout-note" data-note="split">Split view keeps the list beside the email you're reading.</p>
        <p class="layout-note" data-note="wide">Wide view gives the list the whole window, one email per line. Opening one fills the same space.</p>
      </div>

      <ul class="keys" aria-label="Some default shortcuts">
        <li><kbd>E</kbd>Archive</li>
        <li><kbd>R</kbd>Reply</li>
        <li><kbd>J</kbd><kbd>K</kbd>Next, previous</li>
        <li><kbd>/</kbd>Search</li>
        <li><kbd>⌘K</kbd>Commands</li>
      </ul>
    </div>

    <section id="features" class="row center wrap">
      <div class="row-text">
        <span class="ai-mark" aria-hidden="true"><Fragment set:html={aiIcon} /></span>
        <h2>AI when you want it.</h2>
        <p>Bring your own AI account, from Anthropic, OpenAI, Google, a local model or another provider. It's off until you add one, and requests go straight from your Mac to that provider.</p>
      </div>
      <div class="bento">
        <div class="stage bento-card">
          <h3><i class="ph ph-pencil-line" aria-hidden="true"></i>Write and reply</h3>
          <p>Draft a reply from a few notes, or tidy up what you wrote.</p>
          <div class="panel" aria-hidden="true">
            <div class="cmd on"><i class="ph ph-arrow-bend-up-left" aria-hidden="true"></i>Draft a reply</div>
            <div class="cmd"><i class="ph ph-magic-wand" aria-hidden="true"></i>Improve writing</div>
            <div class="cmd"><i class="ph ph-text-aa" aria-hidden="true"></i>Make shorter</div>
          </div>
        </div>
        <div class="stage bento-card">
          <h3><i class="ph ph-tag" aria-hidden="true"></i>Labels that sort themselves</h3>
          <p>Describe your labels once in plain words. New mail is labelled as it arrives.</p>
          <div class="panel ai-labels" aria-hidden="true">
            <div class="mini"><i class="dot blue"></i><b>Northbank</b><span>Invoice #2048</span><i class="chip green">Invoice</i></div>
            <div class="mini"><i class="dot green"></i><b>Ari Novak</b><span>Logo feedback</span><i class="chip">Clients</i></div>
            <div class="mini"><i class="dot pink"></i><b>Jonah Lee</b><span>Lunch next week?</span><i class="chip violet">Personal</i></div>
          </div>
        </div>
        <div class="stage bento-card">
          <h3><i class="ph ph-broom" aria-hidden="true"></i>Clean up your Inbox</h3>
          <p>Shift suggests what to archive. Nothing moves until you say so.</p>
          <div class="panel" aria-hidden="true">
            <div class="mini"><i class="dot blue"></i><b>Newsletters</b><span>12 emails</span><time>Archive</time></div>
            <div class="mini"><i class="dot green"></i><b>Receipts</b><span>5 emails</span><time>Archive</time></div>
            <div class="mini"><i class="dot pink"></i><b>Old threads</b><span>8 emails</span><time>Archive</time></div>
          </div>
        </div>
      </div>
    </section>

    <section class="row wrap">
      <div class="row-text">
        <h2>Every account.<br />One inbox.</h2>
        <p>Gmail, iCloud, Fastmail or your own domain side by side, each with its own colour. Or open one account at a time.</p>
        <ul class="points">
          <li><i class="ph ph-tray" aria-hidden="true"></i><b>Unified inbox</b>Leave any account out of it in Settings.</li>
          <li><i class="ph ph-stack" aria-hidden="true"></i><b>Smart Inbox</b>Pinned mail first, then new mail from people, then notifications, then what you've already seen.</li>
          <li><i class="ph ph-magnifying-glass" aria-hidden="true"></i><b>Instant search</b>Results appear as you type, from the copy on your Mac.</li>
          <li><i class="ph ph-bell" aria-hidden="true"></i><b>Notifications that matter</b>Optionally only from people, not newsletters.</li>
        </ul>
      </div>
      <div class="stage bleed">
        <Shot light={accountsLight} dark={accountsDark} alt="The sidebar with two accounts in one Inbox, and the Smart Inbox's Pinned and People sections" />
      </div>
    </section>

    <section class="row center wrap">
      <div class="row-text">
        <h2>Hands stay on the keys.</h2>
        <p>Archive, reply, label and move without the mouse. Every shortcut can be remapped, and the defaults match Spark and Apple Mail.</p>
        <ul class="points">
          <li><i class="ph ph-command" aria-hidden="true"></i><b>Command palette</b>Press ⌘K and type what you want to do.</li>
          <li><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i><b>Undo</b>Archived the wrong thread? ⌘Z brings it back.</li>
        </ul>
      </div>
      <div class="stage">
        <div class="framed palette-shot">
          <Shot light={paletteLight} dark={paletteDark} alt="The command palette listing actions for the open email with their shortcuts" />
        </div>
      </div>
    </section>

    <section class="row flip wrap">
      <div class="row-text">
        <h2>Send it later.<br />Or take it back.</h2>
        <p>Write tonight and have it arrive in the morning. Shift sends it at the time you picked, even with the window closed.</p>
        <ul class="points">
          <li><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i><b>Undo send</b>The email waits on your Mac for a few seconds before it goes.</li>
          <li><i class="ph ph-shield-check" aria-hidden="true"></i><b>Trackers blocked</b>Remote images stay hidden until you load them.</li>
        </ul>
      </div>
      <div class="stage">
        <div class="framed composer-shot">
          <Shot light={composerLight} dark={composerDark} alt="The composer with a draft, sending from one of two accounts" />
        </div>
        <div class="float later" aria-hidden="true">
          <div class="float-title">Send later</div>
          <div class="opt">Later today<small>6:00 pm</small></div>
          <div class="opt on">Tomorrow morning<small>8:00 am</small></div>
          <div class="opt">Next week<small>Mon 8:00 am</small></div>
        </div>
        <div class="toast" aria-hidden="true">Sending in 5s<b>Undo</b></div>
      </div>
    </section>

    <section id="privacy" class="band">
      <div class="row center wrap">
      <div class="row-text">
        <h2>Your Mac, your mail provider, and nothing else.</h2>
        <p>Your mail travels one way: straight between your Mac and your mail provider. Shift has nothing in the middle to read it, store it or lose it. Turn on AI and only the AI provider you chose joins in.</p>
        <ul class="points">
          <li><i class="ph ph-hard-drives" aria-hidden="true"></i><b>No Shift servers</b>No account to create, and no copy of your mail anywhere but your Mac.</li>
          <li><i class="ph ph-key" aria-hidden="true"></i><b>Sign-in in the Keychain</b>macOS keeps your sign-in, the same way it keeps your passwords.</li>
          <li><i class="ph ph-eye-slash" aria-hidden="true"></i><b>No analytics</b>Shift collects nothing about how you use it and shows no ads.</li>
          <li><i class="ph ph-wifi-slash" aria-hidden="true"></i><b>Works offline</b>Read, archive and label on a plane. Changes reach your mail when you're back online.</li>
        </ul>
      </div>
      <div class="stage">
        <div class="flow" aria-hidden="true">
          <div class="node">
            <span class="tile"><img src="/icon.png" alt="" width="256" height="256" /></span>
            <b>Your Mac</b>
            <span class="tag"><i class="ph ph-database"></i>Mail stored here</span>
            <span class="tag"><i class="ph ph-key"></i>Sign-in in Keychain</span>
          </div>
          <div class="wire"><i class="packet"></i><i class="packet back"></i><small><i class="ph ph-lock-simple"></i>Direct, encrypted</small></div>
          <div class="node">
            <span class="tile"><i class="ph ph-envelope-simple"></i></span>
            <b>Your mail provider</b>
            <span class="tag"><i class="ph ph-cloud"></i>Gmail, iCloud, your domain</span>
          </div>
        </div>
      </div>
      </div>
    </section>

    <section class="closing wrap">
      <img src="/icon.png" alt="" width="88" height="88" />
      <h2>Try Shift.</h2>
      <p>Free, open source under the MIT licence, and updates itself.</p>
      <div class="downloads">
        <a class="pill" href="/download"><span class="apple-logo" aria-hidden="true"></span>Download for macOS</a>
        <a class="pill ghost" href="https://github.com/nboada/Shift"><i class="ph ph-github-logo" aria-hidden="true"></i>View on GitHub</a>
      </div>
    </section>
  </main>
</Base>
